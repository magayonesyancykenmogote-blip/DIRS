{
  "version": 2,
  "buildCommand": "npm run build --prefix frontend && npm install --prefix . --legacy-peer-deps",
  "outputDirectory": "frontend/dist",
  "public": "frontend/dist",
  "env": {
    "MONGO_URI": "@MONGO_URI",
    "MONGO_DB_NAME": "document_db"
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
