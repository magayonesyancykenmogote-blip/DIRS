{
  "version": 2,
  "buildCommand": "npm install && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "backend/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "env": {
    "MONGO_URI": "@MONGO_URI",
    "MONGO_DB_NAME": "document_db",
    "NODE_ENV": "production"
  }
}
