# MongoDB Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/document_db?authSource=admin&retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/document_db?authSource=admin&retryWrites=true&w=majority
MONGO_DB_NAME=document_db

# Frontend & Backend Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
NODE_ENV=development

# Vercel Production URLs (set these in Vercel dashboard)
# FRONTEND_URL_PROD=https://your-domain.vercel.app
# VITE_API_URL_PROD=https://your-domain.vercel.app/api

# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_key

# Server Configuration (Local Development Only)
SERVER_PORT=4000

# ============================================
# INSTRUCTIONS FOR VERCEL DEPLOYMENT
# ============================================
# 1. Go to https://vercel.com/dashboard
# 2. Select your project
# 3. Click Settings → Environment Variables
# 4. Add these variables for Production:
#    - MONGODB_URI: Your MongoDB connection string
#    - FRONTEND_URL: Your Vercel app URL (e.g., https://myapp.vercel.app)
#    - NODE_ENV: production
# 5. Redeploy your project after adding variables
# 6. Update your frontend VITE_API_URL to point to https://yourapp.vercel.app/api

